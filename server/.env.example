# Copy this file to ".env" (same folder) and edit. .env is not uploaded to GitHub.
# Remove the # in front of any line you want to use. Restart the server after changes.

# Whisper model: a name (downloaded automatically) or a folder you downloaded yourself.
# REDUB_WHISPER_MODEL=small.en
# REDUB_WHISPER_MODEL=C:\Models\faster-whisper-small

# cpu, cuda, or auto
# REDUB_WHISPER_DEVICE=cpu

# int8 (fast on CPU), float16 (GPU), float32
# REDUB_WHISPER_COMPUTE=int8

# Let yt-dlp use your browser sign-in for course sites
# REDUB_COOKIES_BROWSER=chrome
